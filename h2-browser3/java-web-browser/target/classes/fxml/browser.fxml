<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="10" alignment="center">
    <HBox spacing="5" alignment="center">
        <TextField fx:id="urlBar" promptText="Enter URL" />
        <Button fx:id="goButton" text="Go" />
        <Button fx:id="backButton" text="Back" />
        <Button fx:id="forwardButton" text="Forward" />
        <Button fx:id="refreshButton" text="Refresh" />
        <Button fx:id="homeButton" text="Home" />
    </HBox>
    <WebView fx:id="webView" />
</VBox>